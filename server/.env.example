# ---------------------------------------------------------------
# CampusFix server environment
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# Local port the API listens on
PORT=5000

# development | production
NODE_ENV=development

# MongoDB Atlas connection string
# Atlas -> Cluster -> Connect -> Drivers -> copy string, replace <password>
# The database user needs readWrite access to the campusfix database and the
# machine's public IP must be present under Atlas Network Access.
MONGODB_USERNAME=<database-user>
MONGODB_PASSWORD=<database-password>
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster>.mongodb.net/campusfix?retryWrites=true&w=majority
# Explicit database name; wins over any path in the URI above.
MONGODB_DB_NAME=campusfix

# Secret used to sign JWTs. Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Public URL of the deployed React app (used for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary account -> Settings -> Upload settings -> "Api Keys" tab
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
